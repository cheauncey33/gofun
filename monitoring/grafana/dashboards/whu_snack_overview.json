{
  "title": "WHU Snack GO Overview",
  "uid": "whu-snack",
  "panels": [
    {
      "title": "QPS (Requests Per Second)",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "P99 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "P50 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "Error Rate (4xx+5xx)",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(http_requests_total[1m]))",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "title": "Total Orders Created",
      "targets": [
        {
          "expr": "rate(orders_created_total[1m])",
          "legendFormat": "orders/min"
        }
      ]
    },
    {
      "title": "Seckill Request Results",
      "targets": [
        {
          "expr": "rate(seckill_requests_total[1m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Active HTTP Connections",
      "targets": [
        {
          "expr": "active_http_connections",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "title": "MQ Messages Published Rate",
      "targets": [
        {
          "expr": "rate(mq_messages_published_total[1m])",
          "legendFormat": "publish/min"
        }
      ]
    },
    {
      "title": "MQ Messages Consumed Rate",
      "targets": [
        {
          "expr": "rate(mq_messages_consumed_total[1m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Stock Compensation",
      "targets": [
        {
          "expr": "rate(stock_compensation_total[5m])",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  }
}
