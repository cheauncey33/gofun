# 根目录 .env —— docker compose 默认读取此文件。
# 使用方式：cp .env.example .env，然后逐项替换为真实随机值。
#
# 生成强密钥的参考命令：
#   openssl rand -hex 32

APP_ORIGIN=http://localhost

MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_MAX_CONNECTIONS=300

REDIS_PASSWORD=change-this-redis-password
RABBITMQ_PASSWORD=change-this-rabbitmq-password

# JWT 会话密钥：泄漏即等于任意用户登录。
JWT_SECRET=change-this-long-random-jwt-secret

# 电子票二维码签名密钥：泄漏可被伪造入场凭证，务必与其他密钥不同。
# 此项此前缺失，会导致票据签名密钥为空，上线前必须补齐。
TICKET_QR_SECRET=change-this-long-random-ticket-qr-secret

# 支付沙箱回调的 HMAC 密钥：泄漏可被伪造「已支付」回调。
# 此项此前同样缺失，会导致回调验签形同虚设，上线前必须补齐。
PAYMENT_SANDBOX_SECRET=change-this-long-random-payment-secret

# 库存两种新型运维参数（可选，缺省值已足够保守）：
# INVENTORY_RETURN_RETRY_ENABLED=true
# INVENTORY_RETURN_RETRY_MAX_ATTEMPTS=12
